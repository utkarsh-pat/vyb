NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
VYB_API_BASE_URL=http://localhost:4000
VYB_REALTIME_PUBLIC_ORIGIN=http://localhost:4000
VYB_INTERNAL_API_KEY=local-vyb-internal-key
VYB_GAME_SESSION_SECRET=replace-with-a-random-32-byte-secret
VYB_GAMES_WS_URL=ws://localhost:8787
# Shared Cloudflare Durable Object feed invalidation hub. The same secret is
# stored as SOCIAL_FANOUT_SECRET on the Worker; never expose it to clients.
VYB_SOCIAL_REALTIME_PUBLIC_ORIGIN=http://localhost:8787
VYB_SOCIAL_REALTIME_SECRET=replace-with-a-random-32-byte-secret
VYB_ANALYTICS_VIEWER_KEY_SECRET=local-vyb-analytics-viewer-key
# Beta 14; after 30 stable days 7; emergency storage pressure 3.
VYB_ANALYTICS_RAW_RETENTION_DAYS=14
VYB_SESSION_SECRET=replace-with-a-long-random-session-secret
VYB_CORS_ALLOWED_ORIGINS=http://localhost:3000
VYB_WEB_ORIGIN=http://localhost:3000

# Generate with: pnpm --filter @vyb/web exec web-push generate-vapid-keys
VYB_VAPID_SUBJECT=mailto:support@example.com
VYB_VAPID_PUBLIC_KEY=replace-with-web-push-public-key
NEXT_PUBLIC_VYB_VAPID_PUBLIC_KEY=replace-with-web-push-public-key
VYB_VAPID_PRIVATE_KEY=replace-with-web-push-private-key

NEXT_PUBLIC_FIREBASE_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vybnet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vybnet
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=850600134378
NEXT_PUBLIC_FIREBASE_APP_ID=1:850600134378:web:b0736b5c5bf0386526b993

FIREBASE_PROJECT_ID=vybnet
# Local development only. Cloud Run should use service identity instead.
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\vyb\\secrets\\firebase-admin.json

FIREBASE_DATACONNECT_SERVICE_ID=vyb
FIREBASE_DATACONNECT_LOCATION=asia-south1

# Cloudflare R2 stores all new user-uploaded media. Keep every value server-side.
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=vyb-media-production
# Custom domain or R2 public development URL, without a trailing slash.
R2_PUBLIC_BASE_URL=https://media.example.com
# Deployed game level routes always use DataConnect by default; local seed fallback is for development only.
# Set VYB_QUEENS_LEVELS_SOURCE=dataconnect to require DataConnect and fail fast when it is unavailable.
# Set VYB_QUEENS_LEVELS_SOURCE=local only for development with a server-only data/queens-levels.json fallback.
# VYB_QUEENS_LEVELS_SOURCE=auto
# Current first-onboarded college reference values for local development.
VYB_DEFAULT_TENANT_SLUG=kiet
VYB_DEFAULT_TENANT_DOMAIN=kiet.edu
