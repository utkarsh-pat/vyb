{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts", "./env.d.ts", "@cloudflare/vitest-pool-workers/types"],
    "paths": {
      "@vyb/game-engine": ["../../packages/game-engine/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts", "env.d.ts"]
}
