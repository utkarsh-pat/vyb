# Cloud Build backend context: deny everything, then allow only runtime inputs.
**

!.dockerignore
!Dockerfile
!cloudbuild.backend.yaml
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml

!apps/
!apps/backend/
!apps/backend/**
apps/backend/.gitignore
apps/backend/.vercel/
apps/backend/.vercel/**
apps/backend/data/
apps/backend/data/**
apps/backend/node_modules/
apps/backend/node_modules/**
apps/backend/README.md
apps/backend/scripts/**
apps/backend/**/*.test.mjs

!packages/
!packages/config/
!packages/config/**
packages/config/README.md
!packages/dataconnect/
!packages/dataconnect/campus-admin-sdk/
!packages/dataconnect/campus-admin-sdk/**
!packages/dataconnect/identity-admin-sdk/
!packages/dataconnect/identity-admin-sdk/**
!packages/dataconnect/marketplace-admin-sdk/
!packages/dataconnect/marketplace-admin-sdk/**
!packages/dataconnect/moderation-admin-sdk/
!packages/dataconnect/moderation-admin-sdk/**
!packages/dataconnect/resources-admin-sdk/
!packages/dataconnect/resources-admin-sdk/**
!packages/dataconnect/social-admin-sdk/
!packages/dataconnect/social-admin-sdk/**
packages/dataconnect/**/node_modules/
packages/dataconnect/**/node_modules/**
**/node_modules/
**/node_modules/**
